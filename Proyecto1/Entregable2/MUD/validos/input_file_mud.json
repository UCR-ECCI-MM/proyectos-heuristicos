{
  "ietf-mud:mud": {
    "mud-version": 1,
    "mud-url": "https://example.com/.well-known/mud/speaker3000.json",
    "mud-signature": "https://example.com/.well-known/mud/speaker3000.json.p7s",
    "last-update": "2026-03-07T12:00:00+00:00",
    "cache-validity": 48,
    "is-supported": true,
    "systeminfo": "Smart Speaker 3000 - acceso a DNS, streaming y actualizaciones",
    "mfg-name": "AudioTech",
    "model-name": "speaker3000",
    "from-device-policy": {
      "access-lists": {
        "access-list": [
          { "name": "mud-speaker-dns" },
          { "name": "mud-speaker-streaming" },
          { "name": "mud-speaker-block-telnet" }
        ]
      }
    },
    "to-device-policy": {
      "access-lists": {
        "access-list": [
          { "name": "mud-speaker-updates" },
          { "name": "mud-speaker-reject-unexpected" }
        ]
      }
    }
  },
  "ietf-access-control-list:acls": {
    "acl": [
      {
        "name": "mud-speaker-dns",
        "type": "ipv4-acl-type",
        "aces": {
          "ace": [
            {
              "name": "allow-dns-udp",
              "matches": {
                "ipv4": { "protocol": 17 },
                "udp": { "destination-port": { "operator": "eq", "port": 53 } }
              },
              "actions": { "forwarding": "accept" }
            },
            {
              "name": "deny-dns-tcp",
              "matches": {
                "ipv4": { "protocol": 6 },
                "tcp": { "destination-port": { "operator": "eq", "port": 53 } }
              },
              "actions": { "forwarding": "drop", "log": true }
            }
          ]
        }
      },
      {
        "name": "mud-speaker-streaming",
        "type": "ipv4-acl-type",
        "aces": {
          "ace": [
            {
              "name": "allow-https-streaming",
              "matches": {
                "ipv4": { "protocol": 6 },
                "tcp": { "destination-port": { "operator": "eq", "port": 443 } },
                "ietf-acldns:dst-dnsname": "streaming.example.com"
              },
              "actions": { "forwarding": "accept", "log": true }
            },
            {
              "name": "block-unencrypted-streaming",
              "matches": {
                "ipv4": { "protocol": 6 },
                "tcp": { "destination-port": { "operator": "eq", "port": 80 } }
              },
              "actions": { "forwarding": "drop" }
            }
          ]
        }
      },
      {
        "name": "mud-speaker-block-telnet",
        "type": "ipv4-acl-type",
        "aces": {
          "ace": [
            {
              "name": "block-telnet",
              "matches": {
                "ipv4": { "protocol": 6 },
                "tcp": { "destination-port": { "operator": "eq", "port": 23 } }
              },
              "actions": { "forwarding": "drop", "log": true }
            },
            {
              "name": "reject-telnet-response",
              "matches": {},
              "actions": { "forwarding": "reject" }
            }
          ]
        }
      },
      {
        "name": "mud-speaker-updates",
        "type": "ipv4-acl-type",
        "aces": {
          "ace": [
            {
              "name": "allow-update-server",
              "matches": {
                "ipv4": { "protocol": 6 },
                "tcp": { "source-port": { "operator": "eq", "port": 443 } },
                "ietf-acldns:src-dnsname": "updates.example.com"
              },
              "actions": { "forwarding": "accept" }
            },
            {
              "name": "log-update-failures",
              "matches": {},
              "actions": { "forwarding": "drop", "log": true }
            }
          ]
        }
      },
      {
        "name": "mud-speaker-reject-unexpected",
        "type": "ipv4-acl-type",
        "aces": {
          "ace": [
            {
              "name": "reject-all-other",
              "matches": {},
              "actions": { "forwarding": "reject" }
            },
            {
              "name": "log-rejected-traffic",
              "matches": {},
              "actions": { "forwarding": "drop", "log": true }
            }
          ]
        }
      }
    ]
  }
}
